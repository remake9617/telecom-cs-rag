# =====================================================================
# 环境变量模板（复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，绝不入库 D19）
# 用法：cp .env.example .env  然后编辑 .env
# =====================================================================

# ---------- 中间件密码（VM 内 docker-compose 读取）----------
MYSQL_ROOT_PASSWORD=cs_root_123
MYSQL_DATABASE=cs_db

# ---------- 模型 API Key（后端 application.yml 读取）----------
# 阿里百炼 DashScope（Chat 主力 qwen-plus）：https://bailian.console.aliyun.com/
AI_DASHSCOPE_API_KEY=sk-your-dashscope-key
# 硅基流动（Embedding bge-m3 / Rerank bge-reranker-v2-m3 / Chat failover 备1）：https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
# 智谱 GLM-4-Flash（Chat failover 备2，免费；不填则跳过注册）
ZHIPU_API_KEY=
# DeepSeek（Chat failover 备3，极低价；不填则跳过注册）
DEEPSEEK_API_KEY=

# ---------- 中间件连接（后端在 Windows、中间件在 VM 时填 VM 的 IP）----------
ES_URIS=http://localhost:9200
MYSQL_HOST=localhost
MYSQL_PORT=13306
REDIS_HOST=localhost
REDIS_PORT=16379

# ---------- 认证（M3：JWT + 管理员播种）----------
# JWT 签名密钥，HS256 要求 ≥32 字节；生产务必换成随机强密钥
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
# 默认管理员 admin 的初始密码（首次启动播种，公网部署前务必改）
ADMIN_DEFAULT_PASSWORD=admin123
