<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.cs</groupId>
        <artifactId>cs-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cs-bootstrap</artifactId>
    <name>cs-bootstrap</name>
    <description>启动装配层：聚合所有业务模块，仅含启动类与主配置，打可执行 jar</description>

    <dependencies>
        <!-- 聚合业务模块（cs-knowledge/cs-infra-ai/cs-framework 经由下列模块传递依赖） -->
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>cs-qa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>cs-ingestion</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>cs-ticket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>cs-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>cs-stats</artifactId>
        </dependency>

        <!-- MySQL 驱动（运行期，版本由 Spring Boot parent 管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- MyBatis-Plus 分页插件（3.5.9 起拆分独立构件，M3 工单分页需要） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>cs-server</finalName>
        <plugins>
            <!-- 继承父 pluginManagement 配置，repackage 打可执行 jar；主类由启动类提供 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
