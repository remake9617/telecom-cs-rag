<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.cs</groupId>
        <artifactId>cs-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cs-framework</artifactId>
    <name>cs-framework</name>
    <description>基础设施层：统一响应/异常/错误码、认证上下文、幂等、配置 fail-fast、通用工具</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 认证上下文工具（SecurityUtils）：仅依赖 security-core（轻量，无自动配置），
             Security 过滤器链由 cs-system 的 starter 引入（M3） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>
        <!-- 限流/幂等注解的 AOP 切面（路10）：Boot 官方 starter，版本由 parent BOM 管理，已报备 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- 限流（Redis Lua 滑动窗口）与幂等（SET NX EX 占位）的 Redis 访问（路10）：
             Boot 官方 starter，cs-qa/cs-system 已用同一 starter，版本由 parent BOM 管理，已报备 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
    </dependencies>
</project>
