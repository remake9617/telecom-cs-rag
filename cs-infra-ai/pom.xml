<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.cs</groupId>
        <artifactId>cs-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>cs-infra-ai</artifactId>
    <name>cs-infra-ai</name>
    <description>AI 能力层：DashScope Chat（qwen-plus）+ OpenAI 兼容 Embedding/Rerank（硅基流动）客户端封装；多供应商路由/熔断（阶段二）</description>

    <dependencies>
        <dependency>
            <groupId>com.cs</groupId>
            <artifactId>cs-framework</artifactId>
        </dependency>
        <!-- 阿里百炼 DashScope：Chat（qwen-plus），自动装配 ChatModel/ChatClient -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>
        <!-- 硅基流动 Embedding(bge-m3)/Rerank(bge-reranker-v2-m3)：走 OpenAI 兼容协议 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
    </dependencies>
</project>
