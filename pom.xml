<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方 parent：提供依赖版本管理 + 插件管理（版本锚点见 DECISIONS.md D20） -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.cs</groupId>
    <artifactId>cs-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>cs-parent</name>
    <description>基于 RAG 的电信运营商智能客服系统 — 父工程</description>

    <!-- ============ 子模块（MVP 后端 9 个；cs-agent 阶段二再加；frontend 为独立 React 工程）============ -->
    <modules>
        <module>cs-framework</module>
        <module>cs-infra-ai</module>
        <module>cs-ingestion</module>
        <module>cs-knowledge</module>
        <module>cs-qa</module>
        <module>cs-ticket</module>
        <module>cs-system</module>
        <module>cs-stats</module>
        <module>cs-bootstrap</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- ===== 版本锚点（D20）：Boot 3.5.16 + Spring AI 1.1.2 + Alibaba 核心 1.1.2.0 / 扩展 1.1.2.1 ===== -->
        <spring-ai.version>1.1.2</spring-ai.version>
        <spring-ai-alibaba.version>1.1.2.0</spring-ai-alibaba.version>
        <!-- Alibaba 模型适配 starter（dashscope 等）由 extensions-bom 管理，版本独立于核心 bom -->
        <spring-ai-alibaba-extensions.version>1.1.2.1</spring-ai-alibaba-extensions.version>

        <!-- ===== 三方库版本 ===== -->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <tika.version>2.9.2</tika.version>
        <jsoup.version>1.18.1</jsoup.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI 核心 BOM：统一管理 spring-ai-* 版本 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring AI Alibaba 核心 BOM：管理 graph/agent/studio/nacos 等编排类模块 -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring AI Alibaba 扩展 BOM：管理 dashscope 等模型适配 starter（cs-infra-ai 依赖） -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-extensions-bom</artifactId>
                <version>${spring-ai-alibaba-extensions.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MyBatis-Plus（Spring Boot 3 专用 starter） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Plus 3.5.9 起分页插件拆分到独立构件（PaginationInnerInterceptor 依赖 jsqlparser） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- 文档解析（M1 入库）：Tika 统一解析 PDF/Word/Excel/MD/TXT；Jsoup 抓 URL -->
            <dependency>
                <groupId>org.apache.tika</groupId>
                <artifactId>tika-core</artifactId>
                <version>${tika.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tika</groupId>
                <artifactId>tika-parsers-standard-package</artifactId>
                <version>${tika.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>

            <!-- JWT（M3 认证，cs-system）：api 编译期 + impl/jackson 运行期 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- ===== 内部模块：供各子模块互相依赖时统一版本 ===== -->
            <dependency>
                <groupId>com.cs</groupId>
                <artifactId>cs-framework</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cs</groupId>
                <artifactId>cs-infra-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cs</groupId>
                <artifactId>cs-ingestion</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cs</groupId>
                <artifactId>cs-knowledge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cs</groupId>
                <artifactId>cs-qa</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cs</groupId>
                <artifactId>cs-ticket</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cs</groupId>
                <artifactId>cs-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cs</groupId>
                <artifactId>cs-stats</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 所有子模块通用依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Spring Boot 打包插件：仅 cs-bootstrap 启用 repackage -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- 国内加速：阿里云公共仓库（Spring AI 1.1.x / Alibaba 1.1.2.x 均已发布至 Maven Central，此处仅加速下载） -->
    <repositories>
        <repository>
            <id>aliyun-public</id>
            <name>Aliyun Public</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>aliyun-plugin</id>
            <name>Aliyun Plugin</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>
</project>
